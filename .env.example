# =================================================================
# SmartRoute - Environment Variables Template
# Safe for public repositories (.env.example)
# =================================================================

# Server Configuration (Optional for static Netlify frontend deployment)
PORT=5000
NODE_ENV=production
CLIENT_URL=http://localhost:5173

# Frontend Environment Variables (Netlify UI: Site configuration > Environment variables)
# In standalone prototype mode on Netlify, leave blank to use the built-in simulated telemetry engine.
# If connecting to an external backend service (e.g. Render, Railway, Heroku), enter its URL:
VITE_API_URL=
VITE_SOCKET_URL=

# Future Database Integration (PostgreSQL / Supabase)
DATABASE_URL=
SUPABASE_URL=
SUPABASE_KEY=
